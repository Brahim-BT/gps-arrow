<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 26, so an adaptive icon is always used and no PNG densities are needed.

     All three layers are their own drawable. <background> is a drawable rather than an @color
     because the ground is a lit surface, and <monochrome> is a drawable of its own because the
     system tints that layer by alpha — reusing the foreground there would flatten the icon's
     gradients into a blob. See each file's own comment. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
