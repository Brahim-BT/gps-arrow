<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theme. This exists only so the activity has a valid
      android:theme and so the splash background matches, avoiding a white flash on launch.
    -->
    <style name="Theme.GpsArrow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
